# Copy this file to .env for local development.
# The credentials below are local-only defaults for the Docker Compose database.
DATABASE_URL=postgresql://auryth:auryth_local_dev_only@127.0.0.1:5432/auryth
NODE_ENV=development
PORT=3000

# Docker Compose PostgreSQL settings (local development only).
POSTGRES_DB=auryth
POSTGRES_USER=auryth
POSTGRES_PASSWORD=auryth_local_dev_only
POSTGRES_PORT=5432

# Only VITE_PUBLIC_* values may be bundled into browser code.
VITE_PUBLIC_APP_NAME=AURYTH
